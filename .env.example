# GS AI Studio backend configuration
#
# Copy this file to `.env` and fill in your own key:
#
#     cp .env.example .env
#
# NEVER commit the real `.env` file. It is git-ignored.

# Magic Hour API key (https://magichour.ai -> API keys)
MAGIC_HOUR_API_KEY=

# Server port (Render / Railway inject their own PORT)
PORT=3000

# Optional: absolute path to an ffmpeg binary.
# Used by the offline cinematic renderer
# (magical-door-scene/build-video.js).
# If empty, the renderer looks for ffmpeg on PATH
# and then in ./bin/ffmpeg.
GS_FFMPEG=
